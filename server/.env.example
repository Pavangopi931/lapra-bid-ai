# GeM-Verify AI Server Configuration
PORT=5000

# Google Gemini API Key
# Replace the placeholder below with your actual Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gemini Model Selection (e.g. gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
